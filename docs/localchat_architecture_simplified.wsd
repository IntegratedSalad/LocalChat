@startuml LocalChat_Simplified_Overview_v6
' Simplified conceptual overview for a presentation slide
' This version keeps Computer A and Computer B side by side
' and increases the horizontal spacing between daemon clouds.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontSize 16
skinparam titleFontSize 20
skinparam packageTitleFontSize 18
skinparam nodesep 170
skinparam ranksep 35
skinparam padding 10
skinparam ArrowThickness 1.3
skinparam linetype ortho

hide stereotype

title LocalChat - DNS-SD Top-level Overview

rectangle "Computer A" as CompA {
  rectangle "Register Service via DNS-SD" as A_Register
  rectangle "Perform DNS-SD Discovery ↻" as A_Browse
  cloud "mDNS/DNS-SD Daemon (Unix Socket)" as A_Daemon

  A_Register -down-> A_Browse
  A_Register -[dashed]down-> A_Daemon
  A_Browse <-[dashed]down- A_Daemon
}

rectangle "Computer B" as CompB {
  rectangle "Register Service via DNS-SD" as B_Register
  rectangle "Perform DNS-SD Discovery ↻" as B_Browse
  cloud "mDNS/DNS-SD Daemon (Unix Socket)" as B_Daemon

  B_Register -down-> B_Browse
  B_Register -[dashed]down-> B_Daemon
  B_Browse <-[dashed]down- B_Daemon
}

' Hidden links force the two computers into two columns.
' Extra dashes and larger nodesep make the distance between the daemon clouds longer.
' A_Register -[hidden]right- B_Register
A_Browse -[hidden]right- B_Browse
' A_Daemon -[hidden]right--- B_Daemon

' Visible communication between local daemons.
A_Daemon -[dashed]right---> B_Daemon
B_Daemon -[dashed]left---> A_Daemon : UDP port 5353

@enduml
